# Copy to .env.local and fill in your own values. Never commit .env.local.

# "mock" makes no paid calls; "live" uses the real providers below.
PROVIDERS=mock

# Spend caps in USD
BUDGET_DAILY_USD=15
BUDGET_MONTHLY_USD=150
CONFIRM_JOB_OVER_USD=2

# Provider API keys
FAL_KEY=
GEMINI_API_KEY=
RUNWAYML_API_SECRET=
SYNC_API_KEY=
ELEVENLABS_API_KEY=
